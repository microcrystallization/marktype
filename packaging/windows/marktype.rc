#include <winver.h>

1 ICON "../../assets/icon.ico"

1 VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "MarkType Contributors"
            VALUE "FileDescription",  "MarkType - Ultra-fast Rust Markdown & LaTeX Editor"
            VALUE "FileVersion",      "0.1.0.0"
            VALUE "InternalName",     "marktype"
            VALUE "OriginalFilename", "marktype.exe"
            VALUE "ProductName",      "MarkType"
            VALUE "ProductVersion",   "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
